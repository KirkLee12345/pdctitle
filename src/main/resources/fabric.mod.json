{
	"schemaVersion": 1,
	"id": "pdctitle",
	"version": "${version}",
	"name": "PDCTitle（称号模组）",
	"description": "纯服务端称号模组：OP 维护称号池并授权玩家，玩家自由佩戴/卸下；称号显示在聊天栏、Tab、头顶名字之前，聊天栏悬停称号可看描述。目标 Minecraft 26.2 / Fabric，零 fabric-api 依赖。",
	"authors": ["KirkLee12345"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["net.kirklee.pdctitle.PDCTitle"]
	},
	"mixins": ["pdctitle.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25"
	}
}
